# ShareSpace Frontend Environment Variables Template
# Copy this file to .env.local and fill in your values.
# DO NOT commit real secrets or credentials to version control.

# Firebase Web App Configuration (Production / Staging)
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="sharespace-dev.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sharespace-dev"
VITE_FIREBASE_STORAGE_BUCKET="sharespace-dev.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Emulator Settings (Set to true to connect to Firebase Emulator Suite in development)
VITE_USE_FIREBASE_EMULATOR=true

# Emulator Host
# - If emulators are running locally on your computer: use "127.0.0.1"
# - If emulators are running on the backend developer's computer: set this to their reachable LAN IP (e.g. "192.168.1.50")
VITE_FIREBASE_EMULATOR_HOST="127.0.0.1"

# Service-specific emulator overrides (default ports from firebase.json)
VITE_FIREBASE_EMULATOR_AUTH_PORT="9099"
VITE_FIREBASE_EMULATOR_FIRESTORE_PORT="8081"
VITE_FIREBASE_EMULATOR_FUNCTIONS_PORT="5001"
VITE_FIREBASE_EMULATOR_STORAGE_PORT="9199"

# Optional: full URL override for Auth emulator if reverse-proxied
# VITE_FIREBASE_EMULATOR_AUTH_URL="http://127.0.0.1:9099"

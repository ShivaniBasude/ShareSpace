rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isCallerActive() {
      return isAuthenticated() && (
        request.auth.token.accountStatus != 'disabled' &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         getUserData(request.auth.uid).accountStatus != 'disabled')
      );
    }

    function isAdmin() {
      return isAuthenticated() && isCallerActive() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData(request.auth.uid).role == 'admin')
      );
    }

    function isInstitutionManager(instId) {
      return isAuthenticated() && isCallerActive() && (
        (request.auth.token.role == 'institution_manager' && request.auth.token.institutionId == instId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData(request.auth.uid).role == 'institution_manager' &&
         getUserData(request.auth.uid).institutionId == instId)
      );
    }

    // Default: Deny all reads and writes until specific collection rules are implemented
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Read access:
      // - Owner can read their own profile (if active)
      // - Institution manager can read profiles of users belonging to their institution
      // - Administrator can read any profile
      allow read: if (isOwner(userId) && isCallerActive()) ||
                     (isAuthenticated() && isCallerActive() && isInstitutionManager(resource.data.institutionId)) ||
                     isAdmin();

      // Create & Delete access:
      // Direct client creation/deletion is blocked.
      // Handled exclusively by trusted Cloud Functions / Admin SDK.
      allow create, delete: if false;

      // Update access:
      // - Owner can update permitted fields only
      // - Role, accountStatus, institutionId, email, uid, createdAt are strictly protected
      // - Administrator can update
      allow update: if (
        isOwner(userId) &&
        isCallerActive() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'accountStatus', 'institutionId', 'email', 'uid', 'createdAt'])
      ) || isAdmin();
    }

    // Placeholders for subsequent phases (Phase 2+)
    match /resources/{resourceId} {
      // Read allowed for active users belonging to the same institution,
      // institution managers, or admins.
      allow read: if isCallerActive() && (
        resource.data.institutionId == request.auth.token.institutionId ||
        isAdmin() ||
        isInstitutionManager(resource.data.institutionId)
      );

      // Update allowed for owner, institution manager, or admin,
      // but only mutable fields are permitted.
      allow update: if (
        (resource.data.ownerId == request.auth.uid && isCallerActive()) ||
        isAdmin() ||
        isInstitutionManager(resource.data.institutionId)
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'id','ownerId','institutionId','quantity','availableQuantity','createdAt','updatedAt','availabilityStatus'
      ]);

      // Direct client creates/deletes are blocked – use privileged functions.
      allow create, delete: if false;
    }

    // BOOKINGS COLLECTION (Phase 3)
    match /bookings/{bookingId} {
      // Read access:
      // - Requester (student/borrower) can view their own bookings
      // - Resource owner can view bookings for their resource
      // - Institution manager can view bookings in their institution
      // - Admin can view any booking
      allow read: if isCallerActive() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isInstitutionManager(resource.data.institutionId) ||
        isAdmin()
      );

      // All mutations must go exclusively through trusted Callable Cloud Functions
      allow write: if false;
    }

    // QR CODES COLLECTION (Phase 4)
    match /qr_codes/{qrId} {
      // Direct client reads:
      // - Requester or resource owner can view metadata
      // - Institution manager and admin can view metadata
      allow read: if isCallerActive() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isInstitutionManager(resource.data.institutionId) ||
        isAdmin()
      );

      // Direct client writes are strictly denied: all QR operations
      // (generate, verify, check-in, check-out) execute in privileged Cloud Functions
      allow write: if false;
    }

    match /approvals/{approvalId} {
      allow read, write: if false;
    }

    match /incidents/{incidentId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }
  }
}
